# ----------------------------------------------------------------------------
# Tidalcase — example environment file
#
# Copy this file to `.env` (which is git-ignored) and fill in the values.
# All variables read by docker-compose.yml are listed here.
#
#   cp .env.example .env
#   # then edit .env
# ----------------------------------------------------------------------------

# === Core (always required) ==================================================

# Public hostname Traefik will serve. For local testing you can use `localhost`.
DOMAIN=tidalcase.example.com

# SQLAlchemy database URL. SQLite is fine for evaluation; PostgreSQL is
# recommended for production. To use the bundled Postgres, enable the `db`
# profile and point this URL at it (see below).
#
# SQLite (default, single-node):
DATABASE_URL=sqlite:////app/data/tidalcase.db
# PostgreSQL example (uncomment and adjust):
# DATABASE_URL=postgresql+psycopg2://tidalcase:tidalcase@tidalcase-postgres:5432/tidalcase

# Flask secret key — used to sign session cookies and JWTs.
# Generate with:  openssl rand -hex 32
SECRET_KEY=change-me-to-a-long-random-string


# === Bundled PostgreSQL (only if you run --profile db) =======================
POSTGRES_DB=tidalcase
POSTGRES_USER=tidalcase
POSTGRES_PASSWORD=change-me


# === Authentik SSO (only if you run --profile auth) ==========================
AUTHENTIK_PG_HOST=tidalcase-postgres
AUTHENTIK_PG_USER=authentik
AUTHENTIK_PG_PASSWORD=change-me
AUTHENTIK_PG_DB=authentik
# Generate with:  openssl rand -base64 60 | tr -d '\n'
AUTHENTIK_SECRET_KEY=change-me-to-a-long-random-string


# === Bundled Docker registry (only if you run --profile registry) ============
REGISTRY_NAME=Tidalcase Registry
# Optional image-name prefix to display in the UI (e.g. "internal/").
REGISTRY_IMAGE_PREFIX=


# === Agent (only if you run --profile agent on this host) ====================
#
# A Tidalcase agent connects a Docker host to a Tidalcase manager so the
# manager can schedule tide sessions on it. The token below is generated by
# the manager — see docs/agents.md for the full procedure.
#
# Token issued by the manager. Treat as a secret.
TIDALCASE_JOIN_TOKEN=
# URL where the manager UI/API is reachable from this agent host.
TIDALCASE_MANAGER_URL=https://tidalcase.example.com
# URL where this agent's nginx is reachable from the manager (port 7443).
TIDALCASE_AGENT_URL=https://agent.example.com:7443


# === Image overrides (optional) ==============================================
#
# By default Tidalcase pulls the public images from GHCR. Override these if
# you mirror them into your own registry or run a fork that publishes its
# images under a different owner.
#
# TIDALCASE_BACKEND_IMAGE=ghcr.io/metalsistem-s-p-a/tidalcase-backend:latest
# TIDALCASE_FRONTEND_IMAGE=ghcr.io/metalsistem-s-p-a/tidalcase-frontend:latest
# TIDALCASE_AGENT_IMAGE=ghcr.io/metalsistem-s-p-a/tidalcase-agent:latest
# TIDALCASE_AGENT_NGINX_IMAGE=ghcr.io/metalsistem-s-p-a/tidalcase-agent-nginx:latest
# TIDALCASE_REGISTRY_IMAGE=ghcr.io/metalsistem-s-p-a/tidalcase-registry:latest
